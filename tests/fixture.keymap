#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define MOUSE 3
#define JP_AT LEFT_BRACKET // @

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        mm2: mm2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp JP_AT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        hl: hold_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };
    };

    /* コメント { } も無視されること */
    keymap {
        compatible = "zmk,keymap";

        base {
            // Q W ...
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I  &kp O  &kp P
&kp A  &kp S  &kp D  &kp F  &kp G  &kp LS(LG(S))     &kp B  &kp H  &kp J  &kp K  &kp L  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B     &kp MINUS  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LGUI  &mt LALT ESC  &lt 2 INT_HENKAN  &lt 1 SPACE  &hl 1 INT_MUHENKAN     &kp BSPC  &kp ENTER  &kp DEL
            >;
        };

        num {
            display-name = "数字";
            bindings = <
&kp N1  &mm2  &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &kp UP  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &tog 2
            >;
        };

        fn {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &kp F3  &kp F4  &kp F5     &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &to 0
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans
            >;
        };
    };
};
